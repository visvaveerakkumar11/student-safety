# Copy to backend/.env and fill in. Never commit .env.

# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (IPv4, port 5432)
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<your-database-password>

# At least 32 random characters, e.g. output of: openssl rand -base64 48
JWT_SECRET=<long-random-secret>
JWT_EXPIRATION_MINUTES=480

# First admin account (created on startup only if no admin exists yet; min 8 char password)
ADMIN_EMAIL=admin@school.edu
ADMIN_PASSWORD=<choose-a-strong-password>
ADMIN_NAME=School Administrator

APP_TIMEZONE=Asia/Kolkata
CORS_ALLOWED_ORIGINS=http://localhost:5173

# RFID + notifications
DUPLICATE_SCAN_WINDOW_SECONDS=10
SIM_NOTIFICATION_FAILURE_RATE=0.08
# Optional: shared key for physical RFID readers (header X-Reader-Key). Leave empty to disable.
RFID_READER_API_KEY=

# Parent alerts: "simulated" (default, nothing is sent) or "sms-gate" (real SMS to each student's parent
# number, sent from an Android phone). Install "SMS Gateway for Android" (https://sms-gate.app) on the
# phone, turn on Cloud Server, tap Start Service, and copy the username/password it shows.
NOTIFICATION_PROVIDER=simulated
SMS_GATE_USERNAME=
SMS_GATE_PASSWORD=
